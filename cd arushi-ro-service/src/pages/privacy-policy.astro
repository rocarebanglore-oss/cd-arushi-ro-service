---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
---
<Layout>
  <Header />
  <div class="pt-24 pb-16 bg-gray-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 bg-white p-8 md:p-12 rounded-xl shadow-sm border border-gray-100">
      <h1 class="text-3xl md:text-4xl font-bold text-blue-900 mb-6">Privacy Policy</h1>
      <p class="text-sm text-gray-500 mb-8">Last Updated: October 2024</p>
      
      <div class="space-y-6 text-gray-600 leading-relaxed">
        <p>At Arushi RO Service, we value your privacy and are committed to protecting your personal information. This Privacy Policy explains how we collect, use, and safeguard your data when you use our website or services.</p>
        
        <h2 class="text-xl font-bold text-gray-800 mt-6 mb-2">1. Information We Collect</h2>
        <p>When you book a service through our website, we may collect the following information:</p>
        <ul class="list-disc list-inside ml-4 space-y-1">
          <li>Your Full Name</li>
          <li>Mobile Number</li>
          <li>PinCode / Address (for service delivery)</li>
          <li>RO Brand Name</li>
        </ul>

        <h2 class="text-xl font-bold text-gray-800 mt-6 mb-2">2. How We Use Your Information</h2>
        <p>We use the collected information solely for the following purposes:</p>
        <ul class="list-disc list-inside ml-4 space-y-1">
          <li>To schedule and provide RO repair/installation services.</li>
          <li>To contact you regarding your booking or service updates.</li>
          <li>To improve our customer service and website experience.</li>
        </ul>

        <h2 class="text-xl font-bold text-gray-800 mt-6 mb-2">3. Data Sharing</h2>
        <p>We do not sell, trade, or rent your personal information to third parties. Your data is only shared with our assigned technicians to fulfill your service request.</p>

        <h2 class="text-xl font-bold text-gray-800 mt-6 mb-2">4. Contact Us</h2>
        <p>If you have any questions about this Privacy Policy, please contact us at +91 9873881738.</p>
      </div>
    </div>
  </div>
  <Footer />
  <StickyBar />
</Layout>