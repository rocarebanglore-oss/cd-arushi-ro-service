---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
---
<Layout>
  <Header />
  <div class="pt-24 pb-16 bg-gray-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 bg-white p-8 md:p-12 rounded-xl shadow-sm border border-gray-100">
      <h1 class="text-3xl md:text-4xl font-bold text-blue-900 mb-6">Disclaimer</h1>
      
      <div class="space-y-6 text-gray-600 leading-relaxed">
        <p>All information on this website is provided for general informational purposes only.</p>
        
        <h2 class="text-xl font-bold text-gray-800 mt-6 mb-2">1. Brand Affiliation</h2>
        <p><strong>Arushi RO Service is an independent service provider.</strong> All brand names, logos, and trademarks (including but not limited to Kent, Aquaguard, Pureit, Livpure, etc.) are the property of their respective owners. Their use on this website does not imply any affiliation, endorsement, or partnership with our company.</p>

        <h2 class="text-xl font-bold text-gray-800 mt-6 mb-2">2. Service Outcomes</h2>
        <p>While we strive for 100% customer satisfaction, we do not guarantee specific outcomes for severely damaged systems or water quality issues that are beyond the scope of our repair services.</p>

        <h2 class="text-xl font-bold text-gray-800 mt-6 mb-2">3. External Links</h2>
        <p>Our website may contain links to external websites. We are not responsible for the content or privacy practices of those sites.</p>
      </div>
    </div>
  </div>
  <Footer />
  <StickyBar />
</Layout>