---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
---
<Layout>
  <Header />
  <div class="pt-24 pb-16 bg-gray-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-blue-900 mb-4">Contact Us</h1>
        <p class="text-gray-600">We are here to help you 24/7. Book your service today!</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Contact Info -->
        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100">
          <h2 class="text-2xl font-bold text-gray-800 mb-6">Get In Touch</h2>
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="bg-blue-100 text-blue-600 w-12 h-12 rounded-full flex items-center justify-center text-xl">
                <i class="fa-solid fa-phone"></i>
              </div>
              <div>
                <p class="text-sm text-gray-500">Call Us</p>
                <a href="tel:9873881738" class="text-lg font-semibold text-gray-800 hover:text-blue-600">+91 9873881738</a>
              </div>
            </div>
            
            <div class="flex items-center gap-4">
              <div class="bg-green-100 text-green-600 w-12 h-12 rounded-full flex items-center justify-center text-xl">
                <i class="fa-brands fa-whatsapp"></i>
              </div>
              <div>
                <p class="text-sm text-gray-500">WhatsApp</p>
                <a href="https://wa.me/919873881738" target="_blank" class="text-lg font-semibold text-gray-800 hover:text-green-600">Message Us</a>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="bg-orange-100 text-orange-600 w-12 h-12 rounded-full flex items-center justify-center text-xl">
                <i class="fa-solid fa-location-dot"></i>
              </div>
              <div>
                <p class="text-sm text-gray-500">Service Area</p>
                <p class="text-lg font-semibold text-gray-800">Delhi NCR (All Areas)</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Form -->
        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100">
           <h2 class="text-2xl font-bold text-gray-800 mb-6">Book a Service</h2>
           <form class="flex flex-col gap-4">
             <input type="text" placeholder="Your Name" class="w-full px-4 py-3 rounded-md border border-gray-300 outline-none focus:ring-2 focus:ring-blue-500" />
             <input type="tel" placeholder="Mobile Number" class="w-full px-4 py-3 rounded-md border border-gray-300 outline-none focus:ring-2 focus:ring-blue-500" />
             <a href="https://wa.me/919873881738" target="_blank" class="w-full bg-blue-600 text-white font-bold py-3 rounded-md hover:bg-blue-700 transition text-center">
               Book via WhatsApp
             </a>
           </form>
        </div>
      </div>
    </div>
  </div>
  <Footer />
  <StickyBar />
</Layout>