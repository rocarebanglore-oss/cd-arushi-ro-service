---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
---
<Layout>
  <Header />
  <div class="pt-24 pb-16 bg-gray-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 bg-white p-8 md:p-12 rounded-xl shadow-sm border border-gray-100">
      <h1 class="text-3xl md:text-4xl font-bold text-blue-900 mb-6">About Arushi RO Service</h1>
      <p class="text-gray-600 leading-relaxed mb-4">
        Welcome to <strong>Arushi RO Service</strong>, your most trusted partner for water purifier solutions in Delhi NCR. We understand that clean and safe drinking water is not a luxury, but a basic necessity for your family's health.
      </p>
      <p class="text-gray-600 leading-relaxed mb-4">
        With over 5 years of experience, our team of certified and factory-trained technicians is dedicated to providing fast, reliable, and affordable RO repair, installation, and maintenance services right at your doorstep.
      </p>
      <p class="text-gray-600 leading-relaxed mb-4">
        Whether it's a filter replacement, motor repair, or a complete system check-up, we use only genuine spare parts to ensure your water purifier runs smoothly for years. We support all major brands including Kent, Aquaguard, Pureit, Livpure, AO Smith, and more.
      </p>
      <div class="mt-8 bg-blue-50 p-6 rounded-lg border border-blue-100">
        <h3 class="text-xl font-bold text-blue-900 mb-2">Why Trust Us?</h3>
        <ul class="list-disc list-inside text-gray-700 space-y-2">
          <li>Same-day doorstep service in Delhi NCR</li>
          <li>100% Genuine spare parts with warranty</li>
          <li>Transparent pricing with no hidden charges</li>
          <li>Expert technicians for all brands</li>
        </ul>
      </div>
    </div>
  </div>
  <Footer />
  <StickyBar />
</Layout>