---
// Footer.astro
---
<footer class="bg-[#0f172a] text-gray-400 pt-12 pb-6 md:pb-12 px-6">
  <div class="max-w-4xl mx-auto flex flex-col">
    
    <!-- Top Gradient Line -->
    <div class="h-1 w-full bg-gradient-to-r from-blue-600 to-cyan-400 mb-10 rounded-full hidden md:block"></div>

    <!-- Logo & Tagline -->
    <div class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="bg-blue-200 text-blue-900 rounded-full w-12 h-12 flex items-center justify-center text-xl">
          <i class="fa-solid fa-glass-water"></i>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-wide">Arushi RO Service</h2>
      </div>
      <p class="text-sm text-gray-400 leading-relaxed max-w-md">
        Your trusted partner for pure, safe water. Professional RO services with genuine parts and certified technicians.
      </p>
    </div>

    <!-- Services -->
    <div class="mb-10">
      <h3 class="text-xl font-semibold text-white mb-4">Services</h3>
      <ul class="space-y-3 text-sm">
        <li><a href="/#services" class="hover:text-blue-400 transition">RO Installation</a></li>
        <li><a href="/#services" class="hover:text-blue-400 transition">RO Repair & Servicing</a></li>
        <li><a href="/#services" class="hover:text-blue-400 transition">Filter Replacement</a></li>
        <li><a href="/#services" class="hover:text-blue-400 transition">Water Quality Testing</a></li>
      </ul>
    </div>

    <!-- Quick Links -->
    <div class="mb-10">
      <h3 class="text-xl font-semibold text-white mb-4">Quick Links</h3>
      <ul class="space-y-3 text-sm">
        <li><a href="/about" class="hover:text-blue-400 transition">About Us</a></li>
        <li><a href="/contact" class="hover:text-blue-400 transition">Contact Us</a></li>
        <li><a href="/privacy-policy" class="hover:text-blue-400 transition">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-blue-400 transition">Terms & Conditions</a></li>
        <li><a href="/disclaimer" class="hover:text-blue-400 transition">Disclaimer</a></li>
      </ul>
    </div>

    <!-- Contact Info -->
    <div class="mb-10">
      <h3 class="text-xl font-semibold text-white mb-4">Contact Info</h3>
      <ul class="space-y-3 text-sm">
        <li class="flex items-center gap-3">
          <i class="fa-solid fa-phone text-gray-500"></i>
          <a href="tel:9873881738" class="hover:text-white transition">+91-9873881738</a>
        </li>
        <li class="flex items-center gap-3">
          <i class="fa-solid fa-location-dot text-gray-500"></i>
          <span>Delhi NCR, India</span>
        </li>
      </ul>
    </div>

    <!-- Disclaimer -->
    <div class="mb-10">
      <h3 class="text-xl font-semibold text-white mb-4">Disclaimer</h3>
      <p class="text-xs text-gray-500 leading-relaxed max-w-3xl">
        All brand names and trademarks belong to their respective owners. Their use does not imply any affiliation or endorsement. Arushi RO Service is an independent service provider.
      </p>
    </div>

    <!-- Copyright Section -->
    <div class="mt-2 pt-6 border-t border-gray-800 text-center text-sm text-gray-500">
      © 2025 Arushi RO Service. All Rights Reserved.
    </div>

  </div>
</footer>