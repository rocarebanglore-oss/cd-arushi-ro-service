---
// TrustBanner.astro
---
<section class="bg-gradient-to-r from-blue-600 to-cyan-500 py-16 px-4">
  <div class="max-w-4xl mx-auto text-center text-white">
    <h2 class="text-3xl md:text-5xl font-bold mb-4">Trusted by 20,000+ Families</h2>
    <p class="text-lg md:text-xl mb-10 max-w-2xl mx-auto">
      Join thousands of satisfied customers who trust us for their RO water purifier needs. Experience the Arushi RO difference today!
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div class="bg-white/20 backdrop-blur-sm p-6 rounded-xl">
        <h3 class="text-3xl font-bold mb-1">4.8 <i class="fa-solid fa-star text-yellow-400 text-2xl"></i></h3>
        <p class="text-blue-100">Average Rating</p>
      </div>
      <div class="bg-white/20 backdrop-blur-sm p-6 rounded-xl">
        <h3 class="text-3xl font-bold mb-1">150+</h3>
        <p class="text-blue-100">Google Reviews</p>
      </div>
      <div class="bg-white/20 backdrop-blur-sm p-6 rounded-xl">
        <h3 class="text-3xl font-bold mb-1">95%</h3>
        <p class="text-blue-100">Repeat Customers</p>
      </div>
    </div>
  </div>
</section>