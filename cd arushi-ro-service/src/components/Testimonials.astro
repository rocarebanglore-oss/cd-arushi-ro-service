<section class="py-16 bg-white px-4">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-center text-blue-900 mb-12">What Our Customers Say</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Review 1 -->
      <div class="bg-gray-50 p-6 rounded-xl border border-gray-100 shadow-sm">
        <div class="flex text-yellow-400 mb-4">
          <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
        </div>
        <p class="text-gray-600 mb-4 italic">"Got service very quickly. The technician arrived on time and fixed the RO perfectly. Their service is the best in Delhi."</p>
