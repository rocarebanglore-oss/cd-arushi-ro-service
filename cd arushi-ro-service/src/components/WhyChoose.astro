---
// WhyChoose.astro
---
<section id="why-us" class="py-16 bg-gray-50 px-4">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-800 mb-4">Why Choose <span class="text-blue-600">Arushi RO Service?</span></h2>
    <p class="text-center text-gray-600 max-w-3xl mx-auto mb-12 text-lg">
      We're not just another service provider. We're your trusted partners in ensuring pure, safe water for your family.
    </p>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
      <div class="bg-blue-50 rounded-xl p-6 text-center shadow-sm">
        <i class="fa-solid fa-medal text-blue-600 text-4xl mb-3"></i>
        <!-- 5+ ko 10+ kar diya -->
        <h3 class="text-3xl font-bold text-gray-800">10+</h3>
        <p class="text-gray-600">Years Experience</p>
      </div>
      <div class="bg-blue-50 rounded-xl p-6 text-center shadow-sm">
        <i class="fa-solid fa-users text-blue-600 text-4xl mb-3"></i>
        <!-- 500+ ko 7500+ kar diya -->
        <h3 class="text-3xl font-bold text-gray-800">7500+</h3>
        <p class="text-gray-600">Happy Customers</p>
      </div>
      <div class="bg-blue-50 rounded-xl p-6 text-center shadow-sm">
        <i class="fa-solid fa-circle-check text-blue-600 text-4xl mb-3"></i>
        <h3 class="text-3xl font-bold text-gray-800">98%</h3>
        <p class="text-gray-600">Success Rate</p>
      </div>
      <div class="bg-blue-50 rounded-xl p-6 text-center shadow-sm">
        <i class="fa-solid fa-phone-volume text-blue-600 text-4xl mb-3"></i>
        <h3 class="text-3xl font-bold text-gray-800">24/7</h3>
        <p class="text-gray-600">Support Available</p>
      </div>
    </div>

    <!-- Colored Feature Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-blue-500 p-6 text-white">
          <i class="fa-solid fa-certificate text-3xl mb-2"></i>
          <h3 class="text-xl font-bold">Certified Technicians</h3>
        </div>
        <div class="p-6 text-gray-600">Our team consists of factory-trained and certified RO specialists with years of experience in water purifier servicing.</div>
      </div>

      <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-green-500 p-6 text-white">
          <i class="fa-solid fa-clock text-3xl mb-2"></i>
          <h3 class="text-xl font-bold">Fast Doorstep Service</h3>
        </div>
        <div class="p-6 text-gray-600">Same-day and emergency services available. We come to your location at your convenient time.</div>
      </div>

      <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-purple-500 p-6 text-white">
          <i class="fa-solid fa-shield-halved text-3xl mb-2"></i>
          <h3 class="text-xl font-bold">Genuine Spare Parts</h3>
        </div>
        <div class="p-6 text-gray-600">We use only authentic, original spare parts from authorized dealers. Every part comes with a warranty.</div>
      </div>

      <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-orange-500 p-6 text-white">
          <i class="fa-solid fa-indian-rupee-sign text-3xl mb-2"></i>
          <h3 class="text-xl font-bold">Affordable Pricing</h3>
        </div>
        <div class="p-6 text-gray-600">Transparent, competitive pricing with no hidden charges. Get detailed quotations before any work begins.</div>
      </div>
    </div>

  </div>
</section>