---
// FamilyImage.astro
---
<section class="bg-gradient-to-b from-cyan-500 to-blue-600 py-16 px-4">
  <div class="max-w-3xl mx-auto text-center">
    <div class="relative bg-white p-2 md:p-4 rounded-xl shadow-2xl inline-block">
      <img 
        src="/images/family.jpg" 
        alt="Family drinking safe water" 
        class="rounded-lg w-full h-auto object-cover"
      />
      <div class="absolute top-6 left-0 w-full text-center">
        <h2 class="text-2xl md:text-4xl font-extrabold text-gray-800 tracking-wide bg-white/80 inline-block px-4 py-2 rounded">
          PROTECT YOUR <br> LOVED ONES <br> WITH EVERY SIP
        </h2>
      </div>
    </div>
  </div>
</section>