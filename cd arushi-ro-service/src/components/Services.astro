---
// Services.astro
---
<section id="services" class="py-16 bg-white px-4">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-center text-blue-900 mb-12">Our Services</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Card 1 -->
      <div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition">
        <img src="/images/service-1.jpg" alt="RO Service" class="w-full h-56 object-cover" />
        <div class="p-6 text-center">
          <p class="text-gray-600 mb-6 h-16">From filter replacement to full system check-up, get comprehensive RO service without leaving your home.</p>
          <a href="tel:9873881738" class="block w-full bg-blue-900 text-white font-semibold py-3 rounded-md hover:bg-blue-800 transition">Call Now</a>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition">
        <img src="/images/service-2.jpg" alt="RO Repair" class="w-full h-56 object-cover" />
        <div class="p-6 text-center">
          <p class="text-gray-600 mb-6 h-16">Hassle-free RO service at your doorstep—fast response, expert technicians, and complete water purifier care.</p>
          <a href="tel:9873881738" class="block w-full bg-blue-900 text-white font-semibold py-3 rounded-md hover:bg-blue-800 transition">Call Now</a>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition">
        <img src="/images/service-3.jpg" alt="RO Installation" class="w-full h-56 object-cover" />
        <div class="p-6 text-center">
          <p class="text-gray-600 mb-6 h-16">Motor, pump, booster, solenoid valve repair with original components and perfect fitting.</p>
          <a href="tel:9873881738" class="block w-full bg-blue-900 text-white font-semibold py-3 rounded-md hover:bg-blue-800 transition">Call Now</a>
        </div>
      </div>
    </div>
  </div>
</section>